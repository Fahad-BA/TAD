# RapidAPI credentials and the TikTok Scraper endpoint used by the Vite client.
# VITE_ is required for browser-side access; the unprefixed aliases are also
# documented for server-side adapters.
VITE_RAPIDAPI_KEY=your_rapidapi_key
VITE_RAPIDAPI_HOST=your-rapidapi-host.p.rapidapi.com
VITE_RAPIDAPI_ENDPOINT=https://your-rapidapi-host.p.rapidapi.com/your/tiktok/scraper/path

RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=your-rapidapi-host.p.rapidapi.com
RAPIDAPI_ENDPOINT=https://your-rapidapi-host.p.rapidapi.com/your/tiktok/scraper/path
